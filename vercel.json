{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {"api/index.mjs": {"maxDuration": 30, "excludeFiles": "{data,backups,test,e2e,node_modules/@electric-sql/pglite}/**"}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api?route=:path*"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"},
    {"key": "Referrer-Policy", "value": "same-origin"}
  ]}]
}
